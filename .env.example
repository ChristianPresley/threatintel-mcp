# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
# The server reads these from the process environment at startup.

# VirusTotal API key — https://www.virustotal.com/gui/my-apikey
# The free "public" tier is rate-limited to 4 requests/min and 500/day.
VT_API_KEY=

# urlscan.io API key — https://urlscan.io/user/profile/
# Required for submitting scans; search works anonymously but is rate-limited harder.
URLSCAN_API_KEY=
